---
interface Props {
  title: string;
  summary: string;
  status: string;
  tags: string[];
  href: string;
  index: number;
}
const { title, summary, status, tags, href, index } = Astro.props;
---

<a class="research-card" href={href}>
  <div class="card-meta"><span>{String(index).padStart(2, '0')}</span><span>{status}</span></div>
  <h3>{title}</h3>
  <p>{summary}</p>
  <div class="tag-row">{tags.map((tag) => <span>{tag}</span>)}</div>
  <span class="card-action">Follow this question <b aria-hidden="true">↗</b></span>
</a>

<style>
  .research-card { min-height: 360px; padding: clamp(1.6rem, 3vw, 2.4rem); display: flex; flex-direction: column; border: 1px solid var(--line); border-radius: 8px; background: var(--surface); text-decoration: none; }
  .research-card:hover, .research-card:focus-visible { border-color: var(--gold); box-shadow: 0 22px 60px var(--shadow); transform: translateY(-3px); }
  .card-meta { display: flex; justify-content: space-between; gap: 1rem; color: var(--ink-muted); font-family: var(--mono); font-size: .6rem; letter-spacing: .1em; text-transform: uppercase; }
  h3 { margin: 2.4rem 0 1rem; font-family: var(--serif); font-size: clamp(1.6rem, 2.4vw, 2.1rem); font-weight: 400; letter-spacing: -.025em; line-height: 1.15; }
  p { margin: 0; color: var(--ink-soft); font-size: .92rem; }
  .tag-row { display: flex; flex-wrap: wrap; gap: .4rem; margin-top: 1.5rem; }
  .tag-row span { padding: .28rem .52rem; background: var(--gold-wash); color: var(--gold-strong); border-radius: 2px; font-family: var(--mono); font-size: .54rem; letter-spacing: .06em; text-transform: uppercase; }
  .card-action { margin-top: auto; padding-top: 2rem; color: var(--gold-strong); font-size: .75rem; font-weight: 500; }
  .card-action b { margin-left: .35rem; font-weight: 400; }
</style>
