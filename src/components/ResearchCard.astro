---
interface Props {
  title: string;
  summary: string;
  status: string;
  tags: string[];
  href: string;
  index: number;
}
const { title, summary, status, tags, href, index } = Astro.props;
---

<a class="research-card" href={href}>
  <div class="card-meta"><span>{String(index).padStart(2, '0')}</span><span>{status}</span></div>
  <h3>{title}</h3>
  <p>{summary}</p>
  <div class="tag-row">{tags.map((tag) => <span>{tag}</span>)}</div>
  <span class="card-action">Follow this question <b aria-hidden="true">↗</b></span>
</a>

<style>
  .research-card { min-height: 305px; padding: clamp(1.6rem, 2.5vw, 2.1rem); display: flex; flex-direction: column; border: 1px solid var(--line); border-radius: 8px; background: var(--surface); text-decoration: none; }
  .research-card:hover, .research-card:focus-visible { border-color: var(--gold); box-shadow: 0 22px 60px var(--shadow); transform: translateY(-3px); }
  .card-meta { display: flex; justify-content: space-between; gap: 1rem; color: var(--ink-muted); font-family: var(--mono); font-size: .75rem; letter-spacing: .07em; text-transform: uppercase; }
  h3 { margin: 1.8rem 0 .9rem; font-family: var(--serif); font-size: clamp(1.55rem, 2.2vw, 1.95rem); font-weight: 400; letter-spacing: -.025em; line-height: 1.18; }
  p { margin: 0; color: var(--ink-soft); font-size: .96rem; line-height: 1.65; }
  .tag-row { display: flex; flex-wrap: wrap; gap: .4rem; margin-top: 1.5rem; }
  .tag-row span { padding: .3rem .55rem; background: var(--gold-wash); color: var(--gold-strong); border-radius: 2px; font-family: var(--mono); font-size: .75rem; letter-spacing: .04em; text-transform: uppercase; }
  .card-action { margin-top: auto; padding-top: 1.6rem; color: var(--gold-strong); font-size: .86rem; font-weight: 500; }
  .card-action b { margin-left: .35rem; font-weight: 400; }
</style>
