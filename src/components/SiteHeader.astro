---
const pathname = Astro.url.pathname;
const navItems = [
  { href: '/#about', label: 'About', active: pathname === '/' },
  { href: '/research/', label: 'Research', active: pathname.startsWith('/research') },
  { href: '/projects/constellation/', label: 'Building', active: pathname.startsWith('/projects') },
  { href: '/publications/', label: 'Publications', active: pathname.startsWith('/publications') },
  { href: '/writing/', label: 'Writing', active: pathname.startsWith('/writing') },
  { href: '/#contact', label: 'Contact', active: false },
];
---

<header class="site-header">
  <div class="nav-shell">
    <a class="site-name" href="/" aria-label="Azeez Hamzat, home">Azeez Hamzat</a>
    <nav id="site-navigation" class="site-nav" aria-label="Main navigation" data-site-nav data-open="false">
      {navItems.map((item) => (
        <a href={item.href} aria-current={item.active ? 'page' : undefined}>{item.label}</a>
      ))}
      <a class="nav-cv" href="/Azeez_Adewale_Hamzat_CV.pdf" target="_blank" rel="noreferrer" type="application/pdf">CV <span>(PDF)</span></a>
    </nav>
    <div class="nav-actions">
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch theme">
        <span class="theme-icon" aria-hidden="true"></span>
        <span class="theme-label" data-theme-label>Theme</span>
      </button>
      <button class="menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="site-navigation">
        <span class="sr-only" data-menu-label>Open navigation</span>
        <i></i><i></i>
      </button>
    </div>
  </div>
</header>
