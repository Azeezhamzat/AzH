---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { publications } from '../../data/site';

const description = 'Publications and research outputs by Azeez Hamzat across collective intelligence, community knowledge, agriculture, climate equity, and governance.';
const publicationGroups = [
  {
    eyebrow: 'Independent work',
    title: 'Independent manuscripts',
    description: 'Self-directed work developed outside my doctoral research, supervision, and institutional research programme.',
    entries: publications.filter((publication) => publication.independent),
  },
  {
    eyebrow: 'Research outputs',
    title: 'Published and forthcoming',
    description: 'Peer-reviewed, preprint, and accepted work produced through earlier study and collaboration.',
    entries: publications.filter((publication) => !publication.independent),
  },
];
---

<BaseLayout title="Publications" description={description} canonical="/publications/">
  <header class="page-hero shell">
    <p class="eyebrow">Publications and outputs</p>
    <h1 class="page-title">Research made <span class="accent">shareable</span></h1>
    <p class="lede">Published, forthcoming, and independently conducted work across community knowledge, collective intelligence, agricultural systems, climate equity, and anticipatory governance.</p>
  </header>

  <section class="section publication-section">
    <div class="shell publication-groups">
      {publicationGroups.map((group) => (
        <div class="publication-group">
          <div class="group-heading">
            <p class="eyebrow">{group.eyebrow}</p>
            <h2>{group.title}</h2>
            <p>{group.description}</p>
          </div>
          <div class="publication-list">
            {group.entries.map((publication, index) => (
              <article>
                <div class="pub-index">{String(index + 1).padStart(2, '0')}</div>
                <div class="pub-copy">
                  <div class="pub-meta"><span>{publication.year}</span><span>{publication.type}</span></div>
                  <h3>{publication.title}</h3>
                  <p class="authors">{publication.authors}</p>
                  <p class="venue">{publication.venue}</p>
                  <p class="description">{publication.description}</p>
                  {publication.href && publication.action
                    ? <a class="button button-primary" href={publication.href} target="_blank" rel="noreferrer">{publication.action}</a>
                    : publication.status && <span class="status">{publication.status}</span>}
                </div>
              </article>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="section profiles-section">
    <div class="shell profiles-grid"><div><p class="eyebrow">Research profiles</p><h2 class="section-title">Follow the record</h2></div><div class="profile-links"><a href="https://scholar.google.com/citations?user=6CErkzgAAAAJ" target="_blank" rel="noreferrer"><span>Google Scholar</span><b>Publication profile ↗</b></a><a href="https://orcid.org/0009-0007-8804-0283" target="_blank" rel="noreferrer"><span>ORCID</span><b>0009-0007-8804-0283 ↗</b></a><a href="https://www.researchgate.net/profile/Azeez-Hamzat" target="_blank" rel="noreferrer"><span>ResearchGate</span><b>Research network ↗</b></a></div></div>
  </section>
</BaseLayout>

<style>
  .page-hero { padding: clamp(4rem, 7vw, 6.25rem) 0 clamp(3.25rem, 5vw, 4.75rem); }
  .page-hero .lede { margin: 2rem 0 0; }
  .publication-section { padding-top: 0; border-top: 0; }
  .publication-groups { display: grid; gap: clamp(4rem, 7vw, 6rem); }
  .group-heading { display: grid; grid-template-columns: minmax(220px, .7fr) minmax(0, 1.3fr); column-gap: clamp(2rem, 5vw, 5rem); align-items: end; margin-bottom: 2rem; }
  .group-heading .eyebrow { grid-column: 1; }
  .group-heading h2 { grid-column: 1; margin: 1rem 0 0; font-family: var(--serif); font-size: clamp(2rem, 4vw, 3.6rem); font-weight: 400; letter-spacing: -.035em; line-height: 1.05; }
  .group-heading > p:last-child { grid-column: 2; grid-row: 1 / span 2; max-width: 620px; margin: 0; color: var(--ink-soft); }
  .publication-list { border-top: 1px solid var(--line); }
  .publication-list article { display: grid; grid-template-columns: 100px minmax(0, 1fr); gap: clamp(2rem, 4vw, 4.5rem); padding: clamp(2.25rem, 4vw, 3.5rem) 0; border-bottom: 1px solid var(--line); }
  .pub-index { color: var(--gold-strong); font-family: var(--serif); font-size: 2.8rem; }
  .pub-meta { display: flex; gap: .8rem; color: var(--ink-muted); font-family: var(--mono); font-size: .75rem; letter-spacing: .07em; text-transform: uppercase; }
  .pub-meta span + span::before { content: '·'; margin-right: .8rem; }
  .pub-copy h3 { max-width: 900px; margin: 1.1rem 0 .9rem; font-family: var(--serif); font-size: clamp(1.95rem, 3.6vw, 3.2rem); font-weight: 400; letter-spacing: -.03em; line-height: 1.15; }
  .authors, .venue { margin: 0; color: var(--ink-soft); }
  .venue { color: var(--gold-strong); font-style: italic; }
  .description { max-width: 760px; margin: 1.5rem 0 2rem; color: var(--ink-soft); }
  .status { display: inline-flex; padding: .4rem .65rem; background: var(--gold-wash); color: var(--gold-strong); border-radius: 2px; font-family: var(--mono); font-size: .75rem; letter-spacing: .06em; text-transform: uppercase; }
  .profiles-section { background: var(--surface); }
  .profiles-grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: clamp(3rem, 6vw, 5.5rem); }
  .profile-links { border-top: 1px solid var(--line); }
  .profile-links a { padding: 1.4rem 0; display: flex; justify-content: space-between; gap: 1.5rem; border-bottom: 1px solid var(--line); text-decoration: none; }
  .profile-links span { font-family: var(--serif); font-size: 1.35rem; }
  .profile-links b { color: var(--gold-strong); font-size: .84rem; font-weight: 500; }
  @media (max-width: 720px) { .group-heading, .publication-list article, .profiles-grid { grid-template-columns: 1fr; gap: 1rem; } .group-heading .eyebrow, .group-heading h2, .group-heading > p:last-child { grid-column: 1; grid-row: auto; } .pub-index { font-size: 2rem; } .profile-links a { flex-direction: column; gap: .2rem; } }
</style>
