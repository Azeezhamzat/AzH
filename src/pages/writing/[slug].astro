---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCover from '../../components/ArticleCover.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('writing');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props { entry: CollectionEntry<'writing'>; }
const { entry } = Astro.props;
const { Content } = await render(entry);
const allEntries = (await getCollection('writing')).sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
const currentIndex = allEntries.findIndex((item) => item.id === entry.id);
const nextEntry = allEntries[currentIndex + 1] || allEntries[0];
const published = entry.data.published.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const canonical = `/writing/${entry.id}/`;
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: entry.data.published.toISOString(),
  mainEntityOfPage: new URL(canonical, Astro.site).toString(),
  author: { '@type': 'Person', name: 'Azeez Adewale Hamzat', url: 'https://azeezhamzat.com' },
  publisher: { '@type': 'Person', name: 'Azeez Adewale Hamzat', url: 'https://azeezhamzat.com' },
};
---

<BaseLayout title={entry.data.title} description={entry.data.description} canonical={canonical} type="article" image={null}>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <article>
    <header class="article-header reading-shell">
      <a class="back-link" href="/writing/">← All writing</a>
      <p class="eyebrow">{entry.data.category}</p>
      <h1>{entry.data.title}</h1>
      <p class="article-description">{entry.data.description}</p>
      <div class="article-meta"><time datetime={entry.data.published.toISOString()}>{published}</time><span>{entry.data.readingTime}</span><span>Azeez A. Hamzat</span></div>
    </header>
    <div class="article-cover-shell shell"><ArticleCover title={entry.data.title} category={entry.data.category} tone={entry.data.coverTone} /></div>
    <div class="article-body reading-shell"><Content /></div>
    <footer class="article-end reading-shell">
      <p class="eyebrow">Continue reading</p>
      <a href={`/writing/${nextEntry.id}/`}><span>{nextEntry.data.category}</span><strong>{nextEntry.data.title}</strong><b aria-hidden="true">→</b></a>
    </footer>
  </article>
</BaseLayout>

<style is:global>
  .article-header { padding: clamp(4rem, 7vw, 6.5rem) 0 3rem; }
  .back-link { display: inline-flex; margin-bottom: 3rem; color: var(--ink-muted); font-family: var(--mono); font-size: .59rem; letter-spacing: .08em; text-transform: uppercase; }
  .article-header h1 { margin: 0; font-family: var(--serif); font-size: clamp(3rem, 7vw, 6rem); font-weight: 400; letter-spacing: -.045em; line-height: 1.02; }
  .article-description { margin: 2rem 0 0; color: var(--ink-soft); font-size: 1.08rem; line-height: 1.75; }
  .article-meta { display: flex; flex-wrap: wrap; gap: .7rem 1.3rem; margin-top: 2rem; color: var(--ink-muted); font-family: var(--mono); font-size: .58rem; letter-spacing: .07em; text-transform: uppercase; }
  .article-meta span::before { content: '·'; margin-right: 1.3rem; }
  .article-cover-shell { margin-bottom: clamp(4rem, 8vw, 7rem); }
  .article-body { color: var(--ink); font-family: var(--serif); font-size: clamp(1.08rem, 1.5vw, 1.22rem); line-height: 1.82; }
  .article-body > *:first-child { margin-top: 0; font-size: 1.2em; color: var(--ink); }
  .article-body p { margin: 0 0 1.65rem; }
  .article-body h2 { margin: 3.8rem 0 1.2rem; font-size: clamp(2rem, 4vw, 3rem); font-weight: 400; letter-spacing: -.03em; line-height: 1.18; }
  .article-body h3 { margin: 2.8rem 0 1rem; font-size: 1.5rem; font-weight: 500; }
  .article-body a { color: var(--gold-strong); }
  .article-body blockquote { margin: 2.8rem 0; padding: .5rem 0 .5rem 2rem; border-left: 2px solid var(--gold); color: var(--ink-soft); font-size: 1.25em; font-style: italic; }
  .article-body ul, .article-body ol { margin: 0 0 1.8rem; padding-left: 1.3rem; }
  .article-body li { margin-bottom: .65rem; padding-left: .3rem; }
  .article-body hr { margin: 3.5rem 0; border: 0; border-top: 1px solid var(--line); }
  .article-body table { width: 100%; margin: 2rem 0; border-collapse: collapse; font-family: var(--sans); font-size: .82rem; }
  .article-body th, .article-body td { padding: .75rem; border: 1px solid var(--line); text-align: left; vertical-align: top; }
  .article-body th { background: var(--surface); }
  .article-body strong { font-weight: 600; }
  .article-end { margin-top: clamp(4rem, 7vw, 6.5rem); padding: 3rem 0 clamp(4.5rem, 8vw, 7rem); border-top: 1px solid var(--line); }
  .article-end > a { display: grid; grid-template-columns: 1fr auto; gap: .4rem 2rem; text-decoration: none; }
  .article-end a span { color: var(--ink-muted); font-family: var(--mono); font-size: .58rem; letter-spacing: .08em; text-transform: uppercase; }
  .article-end a strong { max-width: 650px; font-family: var(--serif); font-size: clamp(1.7rem, 3.5vw, 2.7rem); font-weight: 400; line-height: 1.16; }
  .article-end a b { grid-column: 2; grid-row: 1 / 3; align-self: center; color: var(--gold-strong); font-size: 2rem; font-weight: 400; }
  @media (max-width: 560px) { .article-meta span::before { display: none; } .article-meta { flex-direction: column; gap: .35rem; } .article-body table { display: block; overflow-x: auto; } }
</style>
